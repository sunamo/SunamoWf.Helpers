<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>SunamoWf</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Description>WinForms helper classes extracted from sunamo.wf (pictures, search-in-listbox, path autocomplete)</Description>
    <Version>26.9.28.1</Version>
    <Authors>www.sunamo.cz</Authors>
    <Copyright>www.sunamo.cz</Copyright>
    <PackageProjectUrl>https://sunamo.github.io/PlatformIndependentNuGetPackages/SunamoWf.Helpers/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sunamo/SunamoWf.Helpers.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Optimize>false</Optimize>
    <PackageReleaseNotes>y</PackageReleaseNotes>
    <NoWarn>CS0649;CA1416;CS8625;CS8618;CS8600;CS8602;CS8604;CS8603;CS8601;CS8629;CS8714;CS8622;CS0108;CS8612;CS0618;CS8073</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="SunamoCollections" Version="26.7.28.3" />
    <PackageReference Include="SunamoExceptions" Version="26.7.28.1" />
    <PackageReference Include="SunamoFileExtensions" Version="26.7.28.1" />
    <PackageReference Include="SunamoFileIO" Version="26.7.28.2" />
    <PackageReference Include="SunamoFileSystem" Version="26.7.28.6" />
    <PackageReference Include="SunamoGetFolders" Version="26.5.18.6" />
    <PackageReference Include="SunamoRandom" Version="26.7.28.1" />
    <PackageReference Include="SunamoString" Version="26.7.28.2" />
    <PackageReference Include="SunamoValues" Version="26.7.28.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SunamoWpf.Core\SunamoWpf.Core\SunamoWpf.Core.csproj" />
    <ProjectReference Include="..\..\SunamoWpf.Data\SunamoWpf.Data\SunamoWpf.Data.csproj" />
  </ItemGroup>
</Project>
