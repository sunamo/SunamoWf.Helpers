<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>SunamoWf</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Description>WinForms helper classes extracted from sunamo.wf (pictures, search-in-listbox, path autocomplete)</Description>
    <Version>26.9.28.1</Version>
    <Authors>www.sunamo.cz</Authors>
    <Copyright>www.sunamo.cz</Copyright>
    <PackageProjectUrl>https://sunamo.github.io/PlatformIndependentNuGetPackages/SunamoWf.Helpers/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sunamo/SunamoWf.Helpers.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Optimize>false</Optimize>
    <PackageReleaseNotes>y</PackageReleaseNotes>
    <NoWarn>CS0649;CA1416;CS8625;CS8618;CS8600;CS8602;CS8604;CS8603;CS8601;CS8629;CS8714;CS8622;CS0108;CS8612;CS0618;CS8073</NoWarn>
  </PropertyGroup>
  <!-- Excluded from the namespace normalization step of the publish tooling (namespaces are intentionally kept as-is). -->
  <ItemGroup>
    <None Remove="_sunamo\**" />
    <None Remove="PicturesDesktopShared.cs" />
    <None Remove="PicturesForms.cs" />
    <None Remove="PicturesHelperFw.cs" />
    <None Remove="PicturesSunamoShared.cs" />
    <None Remove="SearchingInLbWF.cs" />
    <None Remove="TextBoxPath.cs" />
  </ItemGroup>
</Project>
